{
  "name": "licitaai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "typegen": "supabase gen types typescript --local > src/lib/supabase/database.types.ts",
    "lint:migrations": "node scripts/lint-migraciones.mjs",
    "sbom": "npm sbom --sbom-format cyclonedx --omit dev > sbom.cyclonedx.json && echo 'sbom.cyclonedx.json generado'",
    "licenses": "node scripts/check-licenses.mjs",
    "test": "npm run test:hygiene && npm run test:unit",
    "test:hygiene": "node scripts/check-test-hygiene.mjs",
    "test:unit": "node scripts/test-runner.mjs tests/unit",
    "test:integration": "node scripts/test-runner.mjs tests/integration",
    "test:coverage": "c8 --config .c8rc.json node scripts/test-runner.mjs tests/unit",
    "test:e2e": "playwright test",
    "deno:check": "cd supabase/functions && deno check $(git ls-files '*.ts')",
    "check": "npm run typecheck && npm run lint && npm run lint:migrations && npm run test:hygiene",
    "check:bundle": "node scripts/check-bundle.mjs",
    "test:load": "node tests/load/carga-local.mjs",
    "backup:db": "node scripts/backup-db.mjs",
    "backup:config": "node scripts/backup-config.mjs",
    "backup:storage": "node scripts/backup-storage.mjs",
    "restore:verify": "node scripts/restore-verify.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@base-ui/react": "^1.7.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.9.1",
    "@react-email/components": "^1.0.12",
    "@sentry/nextjs": "^10.70.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@tanstack/react-table": "^8.21.3",
    "@tiptap/extension-image": "^3.30.2",
    "@tiptap/extension-table": "^3.30.2",
    "@tiptap/extension-table-cell": "^3.30.2",
    "@tiptap/extension-table-header": "^3.30.2",
    "@tiptap/extension-table-row": "^3.30.2",
    "@tiptap/pm": "^3.30.2",
    "@tiptap/react": "^3.30.2",
    "@tiptap/starter-kit": "^3.30.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.33.0",
    "next": "16.3.2",
    "next-themes": "^0.4.6",
    "node-forge": "^1.4.0",
    "openai": "^7.5.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-dropzone": "^20.1.1",
    "react-hook-form": "^7.85.0",
    "react-pdf": "^10.5.0",
    "resend": "^6.21.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/node-forge": "^1.3.14",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "c8": "^10.1.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "shadcn": "^4.18.0",
    "tailwindcss": "^4",
    "typescript": "^7"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
