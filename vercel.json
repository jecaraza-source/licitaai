{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/alertas-vencimiento",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/job-worker",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/monitoreo",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/retencion",
      "schedule": "17 4 * * *"
    },
    {
      "path": "/api/cron/borrados",
      "schedule": "31 5 * * *"
    }
  ]
}
