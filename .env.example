# Supabase — https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# IA
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Email transaccional — https://resend.com/api-keys
RESEND_API_KEY=
# Opcional: remitente propio, requiere verificar el dominio en resend.com/domains
# Sin esto, se usa el remitente de pruebas "onboarding@resend.dev"
RESEND_FROM_EMAIL=

# Monitoreo de errores — https://sentry.io (opcional, inactivo si se deja vacío)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Cron jobs (Vercel) — cualquier cadena aleatoria, debe coincidir en Vercel
CRON_SECRET=

# Bootstrap del primer admin de plataforma (equipo LicitaAI) — cualquier
# cadena aleatoria. Solo se usa una vez, en POST /api/admin/platform-admins/bootstrap:
# el endpoint se autodeshabilita en cuanto exista al menos un admin de
# plataforma en la tabla platform_admins. Después de ese primer alta, ya no
# hace falta (los siguientes admins/operadores se invitan desde /admin/usuarios).
PLATFORM_ADMIN_BOOTSTRAP_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
